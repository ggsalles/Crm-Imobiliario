{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Represents a client company in the CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "website": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Represents a person (client or team member).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["cliente", "equipe"] },
        "department": { "type": "string" },
        "companyId": { "type": "string", "description": "Reference to a Company ID" },
        "source": { "type": "string", "description": "How the contact reached the company (Instagram, etc.)" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "type", "ownerId"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered user of the CRM.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "userType": { "type": "string", "enum": ["funcionário", "cliente"] },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Represents a sales opportunity in the pipeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "value": { "type": "number" },
        "stage": { "type": "string" },
        "companyId": { "type": "string", "description": "Reference to a Company ID" },
        "contactId": { "type": "string", "description": "Reference to a Contact ID" },
        "propertyId": { "type": "string", "description": "Reference to a Property ID" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "stage", "ownerId"]
    },
    "Property": {
      "title": "Property",
      "description": "Represents a real estate unit (house, apartment, etc.).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["casa", "apartamento", "terreno", "comercial"] },
        "status": { "type": "string", "enum": ["disponível", "reservado", "vendido", "alugado"] },
        "price": { "type": "number" },
        "location": { "type": "string" },
        "cep": { "type": "string" },
        "street": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "area": { "type": "number" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "parkingSpots": { "type": "number" },
        "acceptsFinancing": { "type": "boolean" },
        "notes": { "type": "string" },
        "description": { "type": "string" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "status", "price", "location", "ownerId"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Represents a sales target or goal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetValue": { "type": "number" },
        "month": { "type": "string", "description": "YYYY-MM format" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetValue", "month", "ownerId"]
    },
    "TimelineEvent": {
      "title": "Timeline Event",
      "description": "Represents an event or note in the timeline of an entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "note"] },
        "category": { "type": "string", "enum": ["contact", "deal", "company"] },
        "relatedId": { "type": "string", "description": "ID of the related entity" },
        "content": { "type": "string" },
        "title": { "type": "string" },
        "authorName": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object", "description": "Optional extra data" }
      },
      "required": ["type", "category", "relatedId", "content", "ownerId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat thread between participants.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "category": { "type": "string", "enum": ["client", "team"] },
        "ownerId": { "type": "string" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "type", "category", "ownerId"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message in a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "file"] },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["conversationId", "senderId", "content", "type", "ownerId", "createdAt"]
    }
  },
  "firestore": {
    "contacts": {
      "schema": "Contact",
      "description": "Main collection for individuals."
    },
    "companies": {
      "schema": "Company",
      "description": "Collection for client organizations."
    },
    "properties": {
      "schema": "Property",
      "description": "Collection for real estate properties inventory."
    },
    "deals": {
      "schema": "Deal",
      "description": "Collection for sales opportunities."
    },
    "goals": {
      "schema": "Goal",
      "description": "Collection for sales targets."
    },
    "users": {
      "schema": "UserProfile",
      "description": "User profiles for organization members."
    },
    "timeline": {
      "schema": "TimelineEvent",
      "description": "Activity log and notes for all entities."
    },
    "conversations": {
      "schema": "Conversation",
      "description": "Chat thread headers."
    },
    "messages": {
      "schema": "ChatMessage",
      "description": "Individual messages in chats."
    }
  }
}
